from tkinter import *
def show(event):
    s='光标位于x=%s, y=%s' %(str(event.x),str(event.y))
    lb.config(text = s)
root = Tk()
root.title('鼠标实验')
root.geometry('200x200')
lb=Label(root,text='请单击窗体')
lb.pack()
root.bind('<Button-1>',show)
root.focus_set()    #由于监听整个窗体，此句可省略
root.mainloop()

from tkinter import *
def show(event):
    s = event.keysym
    lb.config(text = s)
root = Tk()
root.title('按键实验')
root.geometry('200x200')
lb=Label(root,text='请按键',font=('黑体',48))
lb.bind('<Key>',show)
lb.focus_set()
lb.pack()
root.mainloop()